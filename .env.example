# ┌─────────────────────────────────────────────────────────┐
# │  agy-telegram-bot — Environment Configuration          │
# │  Copy this file to .env and fill in your values.       │
# │  DO NOT commit .env to version control.                │
# └─────────────────────────────────────────────────────────┘

# ── Required ──────────────────────────────────────────────

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID (get it from @userinfobot)
# Only this user can interact with the bot — everyone else is blocked.
AUTHORIZED_USER_ID=

# ── Optional ──────────────────────────────────────────────

# Default project directory the agent will work in.
# You can switch at any time with /project <path>
# Windows example:
DEFAULT_PROJECT_DIR=C:\Users\you\Projects\my-app
# macOS / Linux example:
# DEFAULT_PROJECT_DIR=/home/you/projects/my-app

# Root directory containing your projects (used for 1-tap project switching in Telegram & Mission Control)
# Windows example:
PROJECTS_ROOT=C:\Users\you\Projects
# macOS / Linux example:
# PROJECTS_ROOT=/home/you/projects

# Gemini API Key (get one from https://aistudio.google.com/)
GEMINI_API_KEY=

# Specific model to use (leave empty for SDK default: gemini-3.7-flash)
# Examples: gemini-3.7-flash, gemini-2.5-pro, gemini-3.5-flash-lite
AGENT_MODEL=gemini-3.7-flash

# Enable voice note transcription (optional)
VOICE_ENABLED=false
